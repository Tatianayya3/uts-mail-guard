// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

namespace public {
  // WARNING: Foreign key "id" -> "auth.users" exists in the database, but its target schema is outside the introspected scope, so no relation field was generated. If the target schema is described by an extension pack, add it to extensions and re-run infer.
  model Profiles {
    id               Uuid              @id(map: "profiles_pkey") @default(dbgenerated("gen_random_uuid()"))
    role             pg.enum(Roles)?   @default("default")
    displayName      String?           @map("display_name")
    avatarUrl        String?           @map("avatar_url")
    createdAt        Timestamptz?      @default(now()) @map("created_at")
    mailScans        MailScans[]
    profileAnalytics ProfileAnalytics?

    @@rls
    @@map("profiles")
  }

  model MailScans {
    id                Uuid        @id(map: "mail_scans_pkey") @default(dbgenerated("gen_random_uuid()"))
    profileId         Uuid        @default(dbgenerated("auth.uid()")) @map("profile_id")
    provider          String
    subject           String      @default("")
    senderEmail       String      @map("sender_email")
    senderDomain      String      @map("sender_domain")
    senderDisplayName String      @default("") @map("sender_display_name")
    trustScore        SmallInt    @map("trust_score")
    verdict           String
    summary           String      @default("")
    advice            String      @default("")
    signals           Jsonb       @default(dbgenerated("'[]'::jsonb"))
    links             Jsonb       @default(dbgenerated("'[]'::jsonb"))
    _model            String      @default("") @map("model")
    analyzedAt        Timestamptz @map("analyzed_at")
    createdAt         Timestamptz @default(now()) @map("created_at")
    emailHash         String?     @map("email_hash")
    profile           Profiles    @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "mail_scans_profile_id_fkey", index: false)

    @@index([profileId, createdAt], map: "mail_scans_profile_created_idx")
    @@index([profileId, senderDomain], map: "mail_scans_profile_domain_idx")
    @@index([profileId, emailHash], map: "mail_scans_profile_hash_idx")
    @@check(expression: "((trust_score >= 0) AND (trust_score <= 100))", map: "mail_scans_trust_score_check")
    @@check(expression: "(verdict = ANY (ARRAY['safe'::text, 'suspicious'::text, 'dangerous'::text, 'unknown'::text]))", map: "mail_scans_verdict_check")
    @@rls
    @@map("mail_scans")
  }

  model ProfileAnalytics {
    profileId         Uuid          @id(map: "profile_analytics_pkey") @map("profile_id")
    totalScans        Int           @default(0) @map("total_scans")
    safeScans         Int           @default(0) @map("safe_scans")
    suspiciousScans   Int           @default(0) @map("suspicious_scans")
    dangerousScans    Int           @default(0) @map("dangerous_scans")
    unknownScans      Int           @default(0) @map("unknown_scans")
    linksReviewed     Int           @default(0) @map("links_reviewed")
    averageTrustScore Numeric(5, 2) @default(0) @map("average_trust_score")
    lastScannedAt     Timestamptz?  @map("last_scanned_at")
    updatedAt         Timestamptz   @default(now()) @map("updated_at")
    profile           Profiles      @relation(fields: [profileId], references: [id], onDelete: Cascade, map: "profile_analytics_profile_id_fkey")

    @@rls
    @@map("profile_analytics")
  }

  native_enum Roles {
    default = "default"
    user = "user"
    @@map("roles")
  }

  policy_insert Users_can_insert_own_profile {
    target = Profiles
    roles = [authenticated]
    withCheck = "(( SELECT auth.uid() AS uid) = id)"
    @@map("Users can insert own profile")
  }

  policy_insert Users_can_insert_their_own_scans {
    target = MailScans
    roles = [authenticated]
    withCheck = "(auth.uid() = profile_id)"
    @@map("Users can insert their own scans")
  }

  policy_select Users_can_read_their_own_analytics {
    target = ProfileAnalytics
    roles = [authenticated]
    using = "(auth.uid() = profile_id)"
    @@map("Users can read their own analytics")
  }

  policy_select Users_can_read_their_own_scans {
    target = MailScans
    roles = [authenticated]
    using = "(auth.uid() = profile_id)"
    @@map("Users can read their own scans")
  }

  policy_update Users_can_update_own_profile {
    target = Profiles
    roles = [authenticated]
    using = "(( SELECT auth.uid() AS uid) = id)"
    withCheck = "(( SELECT auth.uid() AS uid) = id)"
    @@map("Users can update own profile")
  }

  policy_select Users_can_view_own_profile {
    target = Profiles
    roles = [authenticated]
    using = "(( SELECT auth.uid() AS uid) = id)"
    @@map("Users can view own profile")
  }
}
