PORT=4001
# Debe coincidir en los tres servicios. Obligatorio en producción.
INTERNAL_SERVICE_TOKEN=

# auto | jev | llm | heuristic
#   auto: usa Jev si hay TYPESAFE_API_KEY, si no el LLM, si no reglas locales.
DECISION_ENGINE=auto

# Jev (TypeSafe AI) — https://typesafe.ai
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest

# Alternativa: cualquier API compatible con OpenAI Chat Completions
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Opcional: caché distribuida (si se omite, se usa memoria)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CACHE_TTL_SECONDS=604800

# Opcional: protege GET /metrics (Prometheus) con Authorization: Bearer <token>
METRICS_TOKEN=
