PORT=4002
INTERNAL_SERVICE_TOKEN=

# Supabase. Ej: https://abcd.supabase.co (la clave publicable NO es secreta; RLS protege los datos)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Agente Centinela (opcional). Clave SECRETA de Supabase (Settings → API Keys →
# Secret key, o la service_role heredada). Nunca la pongas en la extensión ni en
# el panel. Sin ella el Centinela queda desactivado y el resto funciona igual.
SUPABASE_SECRET_KEY=
# Minutos entre ciclos automáticos del Centinela.
SENTINEL_INTERVAL_MINUTES=30

# Opcional: protege GET /metrics (Prometheus) con Authorization: Bearer <token>
METRICS_TOKEN=
