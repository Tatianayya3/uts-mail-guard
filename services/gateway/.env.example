PORT=4000
INTERNAL_SERVICE_TOKEN=

ANALYSIS_SERVICE_URL=http://localhost:4001
HISTORY_SERVICE_URL=http://localhost:4002

# Supabase: verifica el JWT del usuario. Ej: https://abcd.supabase.co (vacío = todos anónimos)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Producción: chrome-extension://ID_DE_TU_EXTENSION,https://tu-panel.vercel.app
CORS_ORIGINS=*

SCAN_ANONYMOUS_LIMIT=5
SCAN_AUTHENTICATED_LIMIT=100

# Opcional: cuota distribuida (si se omite, se usa memoria)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: protege GET /metrics (Prometheus) con Authorization: Bearer <token>
METRICS_TOKEN=
