{
  "name": "mail-guard",
  "private": true,
  "description": "Mail Guard: detección de phishing en Gmail y Outlook con arquitectura de microservicios.",
  "scripts": {
    "setup": "bun scripts/setup-env.ts",
    "tests:report": "bun scripts/generate-test-report.ts",
    "test:postman": "bunx newman@6.2.1 run docs/postman/mail-guard.postman_collection.json",
    "dev": "turbo run dev",
    "dev:services": "turbo run dev --filter=./services/*",
    "build": "turbo run build",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=22",
    "bun": ">=1.2"
  },
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
